rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if the user is the owner of the document
    function isDocOwner() {
      return isAuthenticated() && resource.data.ownerUserId == request.auth.uid;
    }
    
    // Check if the user is setting themselves as owner on create
    function isSettingSelfAsOwner() {
      return isAuthenticated() && request.resource.data.ownerUserId == request.auth.uid;
    }
    
    // Standard owner create check
    function isDocOwnerCreate() {
      return isSettingSelfAsOwner() && isValidNewDoc();
    }

    // Standard owner update check (preserves ownership)
    function isDocOwnerUpdate() {
      return isDocOwner() && request.resource.data.ownerUserId == resource.data.ownerUserId && isValidNewDoc();
    }
    
    // Check if the user is the creator of the document
    function isCreator() {
      return isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }

    function isSettingSelfAsCreator() {
      return isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
    }

    function isValidSize() {
      return request.resource.size < 1000000;
    }
    
    function isValidNewDoc() {
      return isValidSize();
    }

    // --- Collections ---

    // Users: Self-read/write only
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidNewDoc();
      allow update: if isOwner(userId);
      allow delete: if false; // Prevent users from deleting their own account for now
    }

    // Console Users: Self-read and restricted update (prevent role escalation)
    match /consoleUsers/{userId} {
      allow read: if isOwner(userId);
      allow update: if isOwner(userId) && request.resource.data.role == resource.data.role;
      allow create, delete: if false;
    }

    // Entities: Owner-only access
    match /entities/{entityId} {
      allow read: if isDocOwner();
      allow create: if isDocOwnerCreate();
      allow update: if isDocOwnerUpdate();
      allow delete: if isDocOwner();
    }

    // Teams: Self-read only, NO client writes
    match /teams/{teamId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.members);
      allow write: if false; 
    }

    // Invitations: Owner create/delete, invitee accept/decline
    match /invitations/{invitationId} {
      allow create: if isAuthenticated() && request.resource.data.inviterId == request.auth.uid && isValidNewDoc();
      allow delete: if isAuthenticated() && resource.data.inviterId == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.inviterId == request.auth.uid || resource.data.inviteeEmail == request.auth.token.email);
      allow update: if isAuthenticated() && 
                      resource.data.inviteeEmail == request.auth.token.email && 
                      request.resource.data.inviterId == resource.data.inviterId &&
                      request.resource.data.inviteeEmail == resource.data.inviteeEmail &&
                      isValidNewDoc();
    }

    // Audit Logs: Owner read, authenticated create, immutable
    match /audit_logs/{logId} {
      allow read: if isDocOwner();
      allow create: if isAuthenticated() && request.resource.data.actor.id == request.auth.uid && request.resource.data.ownerUserId == request.auth.uid && isValidNewDoc();
      allow update, delete: if false;
    }

    // Business Data: Owner-only access
    match /distributors/{docId} {
      allow read: if isDocOwner();
      allow create: if isDocOwnerCreate();
      allow update: if isDocOwnerUpdate();
      allow delete: if isDocOwner();
    }

    match /products/{docId} {
      allow read: if isDocOwner();
      allow create: if isDocOwnerCreate();
      allow update: if isDocOwnerUpdate();
      allow delete: if isDocOwner();
    }

    match /sales/{docId} {
      allow read: if isDocOwner();
      allow create: if isDocOwnerCreate();
      allow update: if isDocOwnerUpdate();
      allow delete: if isDocOwner();
    }

    match /supplies/{docId} {
      allow read: if isDocOwner();
      allow create: if isDocOwnerCreate();
      allow update: if isDocOwnerUpdate();
      allow delete: if isDocOwner();
    }

    // Requisitions: Creator or owner access
    match /requisitions/{docId} {
      allow read: if isDocOwner() || isCreator();
      allow create: if isSettingSelfAsOwner() && isSettingSelfAsCreator() && isValidNewDoc();
      allow update: if (isDocOwner() || isCreator()) && request.resource.data.ownerUserId == resource.data.ownerUserId && request.resource.data.createdBy == resource.data.createdBy && isValidNewDoc();
      allow delete: if isDocOwner() || isCreator();
    }

    // Support Tickets: Creator or owner access
    match /support_tickets/{ticketId} {
      allow read: if isDocOwner() || isCreator();
      allow create: if isSettingSelfAsOwner() && isSettingSelfAsCreator() && isValidNewDoc();
      allow update: if (isDocOwner() || isCreator()) && request.resource.data.ownerUserId == resource.data.ownerUserId && request.resource.data.createdBy == resource.data.createdBy && isValidNewDoc();
      allow delete: if isDocOwner() || isCreator();
    }

    // Performance Summaries: Owner read, server-only writes
    match /performance_summaries/{summaryId} {
      allow read: if isDocOwner();
      allow write: if false;
    }

    // Privileged Collections (NO client access)
    match /subscription_plans/{planId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /failed_entity_creations/{docId} {
      allow read, write: if false; 
    }
    
    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
